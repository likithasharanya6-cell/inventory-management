{
  "name": "inventory-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Inventory backend API: PostgreSQL data, file uploads, Supabase token verification and role checks.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "test": "vitest run",
    "verify:supabase": "node scripts/verify-supabase.js",
    "package": "node scripts/package-zip.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "helmet": "8.0.0",
    "jose": "5.9.6",
    "multer": "1.4.5-lts.1",
    "pg": "8.13.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "archiver": "7.0.1",
    "supertest": "7.0.0",
    "vitest": "2.1.4"
  }
}
